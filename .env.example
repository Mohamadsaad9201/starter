# --- Claude ---
ANTHROPIC_API_KEY=

# --- Google Ads (one agency MCC / manager account covers every client) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account id, digits only. Can be overridden per client in clients/<slug>.json
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26

# --- Meta Ads (a Business Manager system-user token with ads_read / ads_management) ---
META_ACCESS_TOKEN=
META_API_VERSION=v24.0

# --- Websites. Per-client secrets use the client slug in CAPS, dashes -> underscores ---
# Shopify Admin API token (custom app, scopes: read/write_content, read/write_products)
SHOPIFY_TOKEN_EXAMPLE_CLIENT=
# WordPress application password (Users -> Profile -> Application Passwords)
WORDPRESS_APP_PASSWORD_EXAMPLE_CLIENT=
# Netlify personal access token (agency-wide)
NETLIFY_TOKEN=

# Set to 1 to run every agent on built-in sample data (no ad/site credentials needed)
MOCK_DATA=
